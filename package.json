{
  "name": "vcsa-academy",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/mobile",
    "frontend",
    "packages/domain"
  ],
  "scripts": {
    "dev:backend": "python3 -m uvicorn backend.app.main:app --reload --host 127.0.0.1 --port 8001",
    "dev:web": "npm --workspace frontend run dev",
    "dev:mobile": "npm --workspace apps/mobile run start",
    "backend:seed": "python3 -m backend.app.cli seed",
    "backend:doctor": "python3 -m backend.app.cli doctor",
    "backend:reset": "python3 -m backend.app.cli reset --yes",
    "test": "node --test packages/domain/test/*.test.mjs",
    "e2e:api": "python3 backend/tests/e2e_smoke.py",
    "check": "npm test && npm run e2e:api",
    "build:web": "npm --workspace frontend run build",
    "doctor:mobile": "npx expo-doctor",
    "export:mobile:web": "cd apps/mobile && npx expo export --platform web --output-dir dist-mobile-web",
    "qa:mobile:screenshots": "node tools/qa/mobile-screenshots.mjs",
    "release:check": "npm run check && npm run build:web && npm run doctor:mobile && npm run export:mobile:web"
  },
  "overrides": {
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "playwright": "^1.59.1"
  }
}
