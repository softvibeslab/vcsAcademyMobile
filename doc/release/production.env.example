# Backend
VCSA_DB_PATH=/var/lib/vcsa/vcsa.sqlite3
VCSA_SESSION_TTL_DAYS=7
VCSA_CORS_ORIGINS=https://app.your-production-domain.com,https://mobile-preview.your-production-domain.com
VCSA_SMART_AGENT_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.2
OPENAI_TIMEOUT_SECONDS=12
ZAI_API_KEY=
ZAI_MODEL=glm-4.7
ZAI_BASE_URL=https://api.z.ai/api/coding/paas/v4
ZAI_TIMEOUT_SECONDS=20
ZAI_THINKING=disabled

# Webapp
VITE_API_BASE_URL=https://api.your-production-domain.com

# Expo mobile
EXPO_PUBLIC_API_BASE_URL=https://api.your-production-domain.com
EXPO_PUBLIC_APP_ENV=production
EXPO_PUBLIC_SENTRY_DSN=
EXPO_APP_NAME=WL Sales Academy
EXPO_APP_SLUG=wl-sales-academy
EXPO_APP_SCHEME=wl-sales-academy
EXPO_IOS_BUNDLE_IDENTIFIER=com.whitelabel.salesacademy
EXPO_IOS_BUILD_NUMBER=1
EXPO_ANDROID_PACKAGE=com.whitelabel.salesacademy
EXPO_ANDROID_VERSION_CODE=1
